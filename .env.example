# Network Reconnaissance environment example
# Copy to .env and adjust for your local lab. Never commit secrets.

# Database (SQLite default; PostgreSQL future migration)
NR_DATABASE_URL=sqlite+aiosqlite:///./nr.db

# Safety: keep true unless you have explicit written authorization and updated scope config.
NR_PRIVATE_LAB_ONLY=true

# Scope config path
NR_SCOPE_CONFIG=./config/scope.example.yaml

# Optional external intelligence APIs (passive OSINT). Leave empty by default.
# These are optional and must be used only for authorized targets/scope.
SHODAN_API_KEY=
CENSUS_API_ID=
CENSUS_API_SECRET=
SECURITYTRAILS_API_KEY=

# Optional future auth placeholder
NR_API_TOKEN=
